---
import { SITE } from '../lib/site';

const target = '/en';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`${SITE}${target}`} />
    <title>Konstantinos Chafis — Software Engineer</title>
    <script is:inline>
      (function () {
        // Client-side fallback for the Pages _middleware.js redirect
        // (used by astro dev / preview and non-Pages hosts).
        var lang = 'en';
        try {
          var saved = localStorage.getItem('preferred-locale');
          if (saved === 'en' || saved === 'el') {
            lang = saved;
          } else {
            var browser = (navigator.language || 'en').toLowerCase();
            if (browser.indexOf('el') === 0) lang = 'el';
          }
        } catch (e) {
          /* storage unavailable — keep default */
        }
        location.replace('/' + lang);
      })();
    </script>
  </head>
  <body>
    <p>
      <a href={target}>Konstantinos Chafis — Software Engineer</a>
    </p>
  </body>
</html>
