---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { hasTechIcon } from '../lib/techIcons';
import TechIcon from './TechIcon.astro';

interface Props {
  /** Cover filename inside src/assets/covers, e.g. "isokratis.webp" */
  cover?: string;
  /** Alt text for the image when a real cover exists */
  alt: string;
  /** Eyebrow label shown on the placeholder (category, first tag, …) */
  label?: string;
  /** Tech tag rendered as a watermark on the placeholder */
  iconTag?: string;
  /** Aspect ratio of the cover area */
  aspect?: 'video' | 'wide';
  class?: string;
}

const { cover, alt, label, iconTag, aspect = 'video', class: className } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/covers/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const source = cover ? images[`../assets/covers/${cover}`]?.default : undefined;

const aspectClass = aspect === 'wide' ? 'aspect-[2/1]' : 'aspect-video';
---

{
  source ? (
    <Image
      src={source}
      alt={alt}
      widths={[480, 768, 1024, 1280]}
      sizes="(min-width: 1024px) 640px, 100vw"
      class:list={['block w-full object-cover', aspectClass, className]}
    />
  ) : (
    <div
      class:list={['relative overflow-hidden bg-surface-2', aspectClass, className]}
      aria-hidden="true"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-accent/[0.12] via-accent/[0.03] to-transparent"></div>
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 1px 1px, rgba(232,230,225,0.07) 1px, transparent 0); background-size: 18px 18px;"
      ></div>
      {label && (
        <span class="absolute left-4 top-4 font-mono text-[10px] uppercase tracking-widest text-ink-faint">
          {label}
        </span>
      )}
      {iconTag && hasTechIcon(iconTag) && (
        <span class="absolute right-4 bottom-3 text-accent/45">
          <TechIcon tag={iconTag} size={46} />
        </span>
      )}
    </div>
  )
}
