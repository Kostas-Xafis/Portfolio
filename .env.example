# Cloudflare Web Analytics beacon token (optional).
#
# 1. Create a site in dash.cloudflare.com → Analytics & Logs → Web Analytics.
# 2. Copy the token from the embed snippet (data-cf-beacon).
# 3. Set it below (or in your shell/CI env) and rebuild.
#
# When unset, no beacon script is rendered.
PUBLIC_CF_BEACON_TOKEN=
