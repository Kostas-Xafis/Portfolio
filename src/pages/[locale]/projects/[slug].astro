---
import { getCollection, render } from 'astro:content';
import ArrowLeftIcon from '../../../components/ArrowLeftIcon.astro';
import ArrowRightIcon from '../../../components/ArrowRightIcon.astro';
import CoverImage from '../../../components/CoverImage.astro';
import ExternalLinkIcon from '../../../components/ExternalLinkIcon.astro';
import JsonLd from '../../../components/JsonLd.astro';
import StarIcon from '../../../components/StarIcon.astro';
import TechIcon from '../../../components/TechIcon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, categoryLabel, pairTranslation, statusLabel, t, type Locale, type ProjectEntry } from '../../../lib/i18n';
import { SITE } from '../../../lib/site';
import { hasTechIcon } from '../../../lib/techIcons';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return LOCALES.flatMap((locale) =>
    projects
      .filter((p) => p.data.lang === locale)
      .map((p) => ({ params: { locale, slug: p.data.slug }, props: { entry: p } })),
  );
}

const { entry } = Astro.props as { entry: ProjectEntry };
const { locale } = Astro.params as { locale: Locale };
const { data } = entry;

const allProjects = await getCollection('projects');
const translation = pairTranslation(allProjects, entry);

const { Content } = await render(entry);

const path = `/${locale}/projects/${data.slug}`;
const links = data.links ?? {};

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.title,
  description: data.summary,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  inLanguage: locale === 'el' ? 'el-GR' : 'en-GB',
  url: links.live ?? links.repo ?? `${SITE}${path}`,
  codeRepository: links.repo,
  author: {
    '@type': 'Person',
    '@id': `${SITE}/#person`,
    name: t(locale, 'name'),
    url: `${SITE}/${locale}`,
  },
};
---

<BaseLayout
  title={data.title}
  description={data.summary}
  locale={locale}
  path={path}
>
  <JsonLd data={projectSchema} />

  <nav class="font-mono text-xs text-ink-faint mb-8">
    <a href={`/${locale}/projects`} class="inline-flex items-center gap-1.5 no-underline hover:text-accent">
      <ArrowLeftIcon size={12} />
      {t(locale, 'nav.projects')}
    </a>
  </nav>

  <div data-reveal class="mb-8">
    <CoverImage
      cover={data.cover}
      alt={data.title}
      label={categoryLabel(locale, data.category)}
      iconTag={data.stack.find((s) => hasTechIcon(s))}
      aspect="wide"
      class="rounded-lg border border-line"
    />
  </div>

  <header class="mb-8" data-reveal>
    <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-ink-faint mb-3">
      <span class="text-accent">{categoryLabel(locale, data.category)}</span>
      <span aria-hidden="true">·</span>
      <span>{statusLabel(locale, data.status)}</span>
      <span aria-hidden="true">·</span>
      <span>{data.year}</span>
      {data.featured && (
        <>
          <span aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-1 text-accent">
            <StarIcon size={11} />
            {t(locale, 'projects.featured')}
          </span>
        </>
      )}
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-5">{data.title}</h1>

    <div class="flex flex-wrap gap-2 mb-6">
      {data.stack.map((tech) => (
        <span class="inline-flex items-center gap-1 font-mono text-xs text-ink-dim bg-surface-2 border border-line rounded px-1.5 py-0.5">
          {hasTechIcon(tech) ? <TechIcon tag={tech} size={13} /> : null}
          {tech}
        </span>
      ))}
    </div>

    {(links.repo || links.live || links.paper) && (
      <div class="flex flex-wrap gap-4 text-sm">
        {links.repo && (
          <a href={links.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 no-underline border border-accent/40 rounded px-4 py-2 hover:border-accent-strong">
            <TechIcon tag="github" size={15} />
            {t(locale, 'label.repo')}
            <ExternalLinkIcon size={15} />
          </a>
        )}
        {links.live && (
          <a href={links.live} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 no-underline text-ink-dim hover:text-ink border border-line rounded px-4 py-2">
            {t(locale, 'label.live')}
            <ExternalLinkIcon size={15} />
          </a>
        )}
        {links.paper && (
          <a href={links.paper} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 no-underline text-ink-dim hover:text-ink border border-line rounded px-4 py-2">
            {t(locale, 'label.paper')}
            <ExternalLinkIcon size={15} />
          </a>
        )}
      </div>
    )}
  </header>

  <article class="prose-dark max-w-none">
    <Content />
  </article>

  <footer class="mt-12 border-t border-line pt-6 font-mono text-xs text-ink-faint">
    {translation ? (
      <a
        href={`/${translation.data.lang}/projects/${translation.data.slug}`}
        class="inline-flex items-center gap-1.5 no-underline hover:text-accent"
      >
        {translation.data.lang === 'el' ? 'Διαβάστε στα ελληνικά' : 'Read in English'}
        <ArrowRightIcon size={12} />
      </a>
    ) : null}
  </footer>
</BaseLayout>
