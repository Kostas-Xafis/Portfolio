---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { LOCALES, t, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}`;

const projects = (await getCollection('projects'))
  .filter((p) => p.data.lang === locale && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === locale && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={t(locale, 'name')}
  description={locale === 'en'
    ? 'Konstantinos Xafis — software engineer building full-stack TypeScript on the Cloudflare edge, machine learning, compilers and systems software.'
    : 'Κωνσταντίνος Χαφής — μηχανικός λογισμικού που αναπτύσσει full-stack TypeScript στο Cloudflare edge, μηχανική μάθηση, compilers και λογισμικό συστημάτων.'}
  locale={locale}
  path={path}
>
  <section class="mb-16">
    <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-3">{t(locale, 'name')}</h1>
    <p class="text-xl text-ink-dim mb-6">
      {t(locale, 'hero.greeting')} — {t(locale, 'hero.location')}
    </p>
    <p class="text-ink-dim leading-relaxed max-w-2xl">
      {
        locale === 'en' ? (
          <>
            I build full-stack TypeScript applications on the Cloudflare edge, write machine
            learning models for geospatial and biological data, and enjoy compiler and systems
            work — from JVM bytecode emission to high-performance arithmetic in C. My thesis work
            on local-area wildfire forecasting was merged into the{' '}
            <a href="https://github.com/d-michail/firecastnet" target="_blank" rel="noopener noreferrer">FireCastNet</a>{' '}
            project, and I design and ship software for Byzantine music.
          </>
        ) : (
          <>
            Αναπτύσσω full-stack εφαρμογές TypeScript στο Cloudflare edge, εκπαιδεύω μοντέλα
            μηχανικής μάθησης σε γεωχωρικά και βιολογικά δεδομένα, και ασχολούμαι με compilers
            και συστήματα — από παραγωγή JVM bytecode έως υπολογισμούς υψηλών επιδόσεων σε C.
            Η διπλωματική μου εργασία στην τοπική μοντελοποίηση πρόβλεψης δασικών πυρκαγιών
            ενσωματώθηκε στο έργο{' '}
            <a href="https://github.com/d-michail/firecastnet" target="_blank" rel="noopener noreferrer">FireCastNet</a>,
            και σχεδιάζω και υλοποιώ λογισμικό για τη βυζαντινή μουσική.
          </>
        )
      }
    </p>
    <div class="flex flex-wrap gap-4 mt-6 text-sm">
      <a href={`/${locale}/projects`} class="no-underline border border-accent/40 rounded px-4 py-2 hover:border-accent-strong">
        {t(locale, 'nav.projects')} →
      </a>
      <a href={`/${locale}/about`} class="no-underline text-ink-dim hover:text-ink border border-line rounded px-4 py-2">
        {t(locale, 'home.about.cta')}
      </a>
      <a href="https://github.com/Kostas-Xafis" target="_blank" rel="noopener noreferrer" class="no-underline text-ink-dim hover:text-ink border border-line rounded px-4 py-2">
        GitHub ↗
      </a>
    </div>
  </section>

  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-xl font-semibold tracking-tight">{t(locale, 'home.featured')}</h2>
      <a href={`/${locale}/projects`} class="font-mono text-xs uppercase tracking-widest">
        {t(locale, 'home.featured.more')} →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((entry) => <ProjectCard entry={entry} locale={locale} featured />)}
    </div>
  </section>

  <section>
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-xl font-semibold tracking-tight">{t(locale, 'home.blog')}</h2>
      <a href={`/${locale}/blog`} class="font-mono text-xs uppercase tracking-widest">
        {t(locale, 'home.blog.more')} →
      </a>
    </div>
    <div class="grid gap-4">
      {posts.map((entry) => <PostCard entry={entry} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
