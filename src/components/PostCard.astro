---
import type { Locale } from '../lib/i18n';
import { formatDate, t } from '../lib/i18n';
import type { BlogEntry } from '../lib/i18n';
import { hasTechIcon } from '../lib/techIcons';
import TechIcon from './TechIcon.astro';

interface Props {
  entry: BlogEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { data } = entry;
const href = `/${locale}/blog/${data.slug}`;
const readingTime = Math.max(1, Math.ceil((entry.body ?? '').length / 1800));
---

<a
  href={href}
  class="group block no-underline border border-line bg-surface rounded-lg p-5 transition-colors duration-150 hover:border-accent/60"
>
  <div class="flex items-center gap-3 mb-2 font-mono text-xs text-ink-faint">
    <time datetime={data.date.toISOString()}>{formatDate(locale, data.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} {t(locale, 'blog.reading')}</span>
  </div>
  <h3 class="text-lg font-semibold text-ink group-hover:text-accent-strong transition-colors mb-2">
    {data.title}
  </h3>
  <p class="text-sm text-ink-dim leading-relaxed">{data.description}</p>
  {data.tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-3">
      {data.tags.map((tag) => (
        <span class="inline-flex items-center gap-1 font-mono text-xs text-ink-dim bg-surface-2 border border-line rounded px-1.5 py-0.5">
          {hasTechIcon(tag) ? <TechIcon tag={tag} size={14} /> : '#'}
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
