---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { LOCALES, t, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/blog`;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === locale && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={t(locale, 'blog.title')}
  description={t(locale, 'blog.subtitle')}
  locale={locale}
  path={path}
>
  <header data-reveal>
    <h1 class="text-4xl font-bold tracking-tight mb-3">{t(locale, 'blog.title')}</h1>
    <p class="text-lg text-ink-dim mb-10">{t(locale, 'blog.subtitle')}</p>
  </header>
  <div class="grid gap-4">
    {posts.map((entry) => <PostCard entry={entry} locale={locale} />)}
  </div>
</BaseLayout>
