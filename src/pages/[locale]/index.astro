---
import { getCollection } from 'astro:content';
import ArrowRightIcon from '../../components/ArrowRightIcon.astro';
import ExternalLinkIcon from '../../components/ExternalLinkIcon.astro';
import JsonLd from '../../components/JsonLd.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, t, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}`;

const projects = (await getCollection('projects'))
  .filter((p) => p.data.lang === locale && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === locale && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/#person`,
  name: t(locale, 'name'),
  url: `${SITE}${path}`,
  jobTitle: t(locale, 'hero.greeting'),
  email: 'mailto:koxafis@gmail.com',
  sameAs: ['https://github.com/Kostas-Xafis'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: locale === 'en' ? 'Attica, Greece' : 'Αττική, Ελλάδα',
    addressCountry: 'GR',
  },
};
---

<BaseLayout
  title={t(locale, 'name')}
  description={locale === 'en'
    ? 'Konstantinos Xafis — software engineer building full-stack TypeScript on the Cloudflare edge, machine learning, compilers and systems software.'
    : 'Κωνσταντίνος Χαφής — μηχανικός λογισμικού που αναπτύσσει full-stack TypeScript στο Cloudflare edge, μηχανική μάθηση, compilers και λογισμικό συστημάτων.'}
  locale={locale}
  path={path}
>
  <JsonLd data={personSchema} />

  <section class="mb-16" data-reveal>
    <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-3">{t(locale, 'name')}</h1>
    <p class="text-xl text-ink-dim mb-6">
      <span
        data-typewriter
        data-words={JSON.stringify(
          locale === 'en'
            ? ['Software Engineer', 'Machine Learning', 'Compilers', 'Systems Software', 'Byzantine Music']
            : ['Μηχανικός Λογισμικού', 'Μηχανική Μάθηση', 'Compilers', 'Λογισμικό Συστημάτων', 'Βυζαντινή Μουσική'],
        )}
        aria-hidden="true"
      >
        {t(locale, 'hero.greeting')}
      </span>
      <span class="sr-only">{t(locale, 'hero.greeting')} — {t(locale, 'hero.location')}</span>
      {' — '}
      {t(locale, 'hero.location')}
    </p>
    <p class="text-ink-dim leading-relaxed max-w-2xl">
      {
        locale === 'en' ? (
          <>
            I build full-stack TypeScript applications on the Cloudflare edge, write machine
            learning models for geospatial and biological data, and enjoy compiler and systems
            work — from JVM bytecode emission to high-performance arithmetic in C. My thesis work
            on local-area wildfire forecasting was merged into the{' '}
            <a href="https://github.com/d-michail/firecastnet" target="_blank" rel="noopener noreferrer">FireCastNet</a>{' '}
            project, and I design and ship software for Byzantine music.
          </>
        ) : (
          <>
            Αναπτύσσω full-stack εφαρμογές TypeScript στο Cloudflare edge, εκπαιδεύω μοντέλα
            μηχανικής μάθησης σε γεωχωρικά και βιολογικά δεδομένα, και ασχολούμαι με compilers
            και συστήματα — από παραγωγή JVM bytecode έως υπολογισμούς υψηλών επιδόσεων σε C.
            Η διπλωματική μου εργασία στην τοπική μοντελοποίηση πρόβλεψης δασικών πυρκαγιών
            ενσωματώθηκε στο έργο{' '}
            <a href="https://github.com/d-michail/firecastnet" target="_blank" rel="noopener noreferrer">FireCastNet</a>,
            και σχεδιάζω και υλοποιώ λογισμικό για τη βυζαντινή μουσική.
          </>
        )
      }
    </p>
    <div class="flex flex-wrap gap-4 mt-6 text-sm">
      <a href={`/${locale}/projects`} class="inline-flex items-center gap-2 no-underline border border-accent/40 rounded px-4 py-2 hover:border-accent-strong">
        {t(locale, 'nav.projects')}
        <ArrowRightIcon size={11} />
      </a>
      <a href={`/${locale}/about`} class="no-underline text-ink-dim hover:text-ink border border-line rounded px-4 py-2">
        {t(locale, 'home.about.cta')}
      </a>
      <a href="https://github.com/Kostas-Xafis" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 no-underline text-ink-dim hover:text-ink border border-line rounded px-4 py-2">
        GitHub
        <ExternalLinkIcon size={15} />
      </a>
    </div>
  </section>

  <section class="mb-16" data-reveal>
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-xl font-semibold tracking-tight">{t(locale, 'home.featured')}</h2>
      <a href={`/${locale}/projects`} class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest">
        {t(locale, 'home.featured.more')}
        <ArrowRightIcon size={11} />
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((entry) => <ProjectCard entry={entry} locale={locale} featured />)}
    </div>
  </section>

  <section data-reveal>
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-xl font-semibold tracking-tight">{t(locale, 'home.blog')}</h2>
      <a href={`/${locale}/blog`} class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest">
        {t(locale, 'home.blog.more')}
        <ArrowRightIcon size={11} />
      </a>
    </div>
    <div class="grid gap-4">
      {posts.map((entry) => <PostCard entry={entry} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<script>
  let typeTimer = 0;

  function runTypewriter() {
    window.clearTimeout(typeTimer);
    const el = document.querySelector<HTMLElement>('[data-typewriter]');
    if (!el) return;
    const target = el;

    let words: string[] = [];
    try {
      words = JSON.parse(target.dataset.words ?? '[]') as string[];
    } catch {
      words = [];
    }
    if (words.length < 2) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      target.textContent = words[0] ?? '';
      return;
    }

    let wi = 0;
    const first = words[0] ?? '';
    let ci = first.length;
    let phase: 'wait' | 'del' | 'type' = 'wait';
    target.textContent = first;

    const HOLD_MS = 5000; // each word stays fully visible for at least 5 seconds
    const TYPE_MS = 75; // per character while typing
    const DEL_MS = 45; // per character while deleting

    function tick() {
      if (phase === 'wait') {
        phase = 'del';
        typeTimer = window.setTimeout(tick, HOLD_MS);
        return;
      }
      if (phase === 'del') {
        ci -= 1;
        if (ci <= 0) {
          ci = 0;
          wi = (wi + 1) % words.length;
          phase = 'type';
        }
        typeTimer = window.setTimeout(tick, DEL_MS);
      } else {
        ci += 1;
        if (ci >= (words[wi] ?? '').length) phase = 'wait';
        typeTimer = window.setTimeout(tick, TYPE_MS);
      }
      target.textContent = (words[wi] ?? '').slice(0, ci);
    }

    typeTimer = window.setTimeout(tick, HOLD_MS);
  }

  runTypewriter();
  document.addEventListener('astro:page-load', runTypewriter);
</script>
